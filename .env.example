# Salin file ini jadi .env untuk development lokal (atau set sebagai env var di Railway).
# Railway otomatis menyediakan DATABASE_URL kalau Postgres plugin sudah di-attach ke service ini.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/detech_lims

# Set true hanya kalau connection string di atas butuh SSL (mis. akses dari luar jaringan
# private Railway lewat public proxy). Kalau app & Postgres jalan di jaringan internal
# Railway yang sama, biasanya tidak perlu.
PGSSL=false

PORT=3000
